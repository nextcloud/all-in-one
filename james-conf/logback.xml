<?xml version="1.0" encoding="UTF-8"?>
<configuration>

        <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
                <resetJUL>true</resetJUL>
        </contextListener>

        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
                <encoder>
                        <pattern>%d{HH:mm:ss.SSS} %highlight([%-5level]) %logger{15} - %msg%n%rEx</pattern>
                        <immediateFlush>false</immediateFlush>
                </encoder>
        </appender>

        <!-- LOCAL CHANGE from James's stock logback.xml: the RollingFileAppender
             writing to /logs/james.log is removed and only CONSOLE is attached to
             the root logger, so everything goes to stdout and `docker compose logs`
             is the single place to read James output. Nothing collects or rotates
             a file inside this container. -->
        <root level="WARN">
                <appender-ref ref="CONSOLE" />
        </root>

        <logger name="org.apache.james" level="INFO" />

</configuration>
