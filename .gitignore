.env
ARCHITECTURE.md
# Private key material -- generated by SETUP.md, not shipped in the repo (same
# treatment as the nginx self-signed cert, which also lives outside git).
james-conf/keystore
# Auto-generated by the James container itself on startup (JMX remote creds) --
# not something we configure, regenerates fine on a fresh container.
james-conf/jmxremote.access
james-conf/jmxremote.password
.gstack/
# Host bind-mount targets: NEXTCLOUD_MOUNT's external-storage dir and the generated
# self-signed cert that SETUP.md drops in trusted-cacerts/. Both are per-machine
# runtime state, same treatment as james-conf/keystore and the nginx cert above.
host-mounts/
