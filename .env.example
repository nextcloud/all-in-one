# Copy to .env and fill in real values. Never commit the real .env file.
# Based on https://github.com/nextcloud/all-in-one/blob/main/manual-install/sample.conf
# -- re-diff against that file before upgrading rather than hand-adding new vars here.

# --- Required secrets (must be unique, good passwords -- avoid '@' and ':') ---
DATABASE_PASSWORD=change-me
EUROOFFICE_SECRET=change-me
FULLTEXTSEARCH_PASSWORD=change-me
IMAGINARY_SECRET=change-me
ONLYOFFICE_SECRET=change-me
NEXTCLOUD_PASSWORD=change-me
RECORDING_SECRET=change-me
REDIS_PASSWORD=change-me
SIGNALING_SECRET=change-me
TALK_INTERNAL_SECRET=change-me
TURN_SECRET=change-me
WHITEBOARD_SECRET=change-me
# Shared secret between Nextcloud (AppAPI) and the context_chat_backend container --
# both sides need the exact same value for their HMAC handshake to work. Not an
# AIO/upstream var, injected manually into both places -- see SETUP.md.
CONTEXT_CHAT_BACKEND_SECRET=change-me
# SMTP AUTH password for the nextcloud@nextcloud.local relay account on James (see
# SETUP.md) -- not an AIO/upstream var, set via `james-cli AddUser`, not env-injected
# into the James container itself.
JAMES_SMTP_PASSWORD=change-me
# Password protecting james-conf/keystore, read by James via
# ${env:JAMES_KEYSTORE_SECRET} in smtpserver.xml/imapserver.xml/pop3server.xml/
# managesieveserver.xml. "james72laBalle" is the password James's own docs use in
# their keytool example, so it is what SETUP.md generates the keystore with -- change
# both together or James fails to start with "keystore password was incorrect".
JAMES_KEYSTORE_SECRET=james72laBalle
# James's own database on the shared PostgreSQL server (created by the
# nextcloud-aio-james-db-init service). Separate from DATABASE_NAME on purpose:
# James and Nextcloud should not share a schema. Reuses DATABASE_USER/PASSWORD.
JAMES_DB_NAME=james_database

# --- Domain / timezone ---
# Hostname you'll access Nextcloud through. Must match the nginx server_name in
# nginx-nextcloud.conf.sample. AIO hardcodes OVERWRITEPROTOCOL=https, so whatever
# fronts this on APACHE_PORT must actually terminate HTTPS (self-signed is fine
# for local dev) -- see SETUP.md.
NC_DOMAIN=nextcloud.local
TIMEZONE=UTC

# --- Optional features: all enabled per Anirban's request ---
# Setting these to "yes" (with quotes) enables the option inside Nextcloud
# automatically. The corresponding --profile flag also has to be passed on
# `docker compose up` for the container itself to be started -- see the profile
# list in the docker-compose.yml header comment.
#
# COMPOSE_PROFILES makes Compose apply every listed profile to EVERY command
# automatically (up, down, stop, ps, ...) without typing --profile flags by hand.
# This matters beyond convenience: a command run without the right --profile flags
# doesn't just skip those services, it treats them as not part of the stack at all --
# `docker compose down -v` without these flags previously deleted only the
# always-on services' volumes (Nextcloud/database/redis/apache) while silently
# leaving every profiled service's volume alone, which is exactly how a full
# Context Chat/Talk/Collabora/etc. reinstall became necessary on 2026-08-25.
# Keep this list in sync with the profiles used in docker-compose.yml.
# This repo's compose file is docker-compose.yml. On the PR branch, upstream
# all-in-one's own compose.yaml sits next to it, and Docker Compose prefers
# compose.yaml -- so without this, every `docker compose` command silently targets
# upstream's stack instead of ours. Pinning it here fixes that for good.
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=collabora,talk,talk-recording,clamav,imaginary,fulltextsearch,whiteboard,ollama,james,context-chat
# Largest file ClamAV will scan, in BYTES. 104857600 = 100 MB (Anirban's request).
# Applied by nextcloud-exec-commands.sh to the files_antivirus app's av_max_file_size
# and av_stream_max_length. Do NOT expect the MAX_SIZE env var on the clamav service
# to do this: that image never reads it, and its clamd.conf ships hardcoded 2000M.
# Files ABOVE this size are accepted by Nextcloud without being scanned. Leave blank
# to leave the app's own defaults alone (-1, meaning no size cap).
CLAMAV_MAX_FILE_SIZE=104857600
CLAMAV_ENABLED="yes"
COLLABORA_ENABLED="yes"
# Both office editors are DEFINED in docker-compose.yml but disabled: Anirban asked
# on PR #1 to keep the config at false rather than delete it. Collabora is the active
# editor. To turn one on, set it to "yes" AND add its profile to COMPOSE_PROFILES --
# the env var alone only tells Nextcloud to use it, it does not start the container.
EUROOFFICE_ENABLED="no"
ONLYOFFICE_ENABLED="no"
FULLTEXTSEARCH_ENABLED="yes"
IMAGINARY_ENABLED="yes"
TALK_ENABLED="yes"
TALK_RECORDING_ENABLED="yes"
WHITEBOARD_ENABLED="yes"
# Ollama isn't an AIO container/env var -- it's added separately in
# docker-compose.yml (nextcloud-aio-ollama, --profile ollama). This just picks
# which model gets pulled; see SETUP.md for the pull step and the manual
# integration_openai admin config it still needs (installing the app doesn't
# configure it, same as the Google/OneDrive integrations above).
OLLAMA_MODEL=llama3.2:3b

# --- Everything below: upstream defaults, unlikely to need changing for local dev ---
AIO_LOG_LEVEL=warn
APACHE_IP_BINDING=127.0.0.1
APACHE_MAX_SIZE=17179869184
APACHE_PORT=11000
ADDITIONAL_COLLABORA_OPTIONS=['--o:security.seccomp=true']
COLLABORA_DICTIONARIES="de_DE en_GB en_US es_ES fr_FR it nl pt_BR pt_PT ru"
# Postgres database and role name. Both the database container and Nextcloud read
# these, so changing either after the first startup leaves the existing volume no
# longer matching -- pick them before the first `up`, not after.
DATABASE_NAME=nextcloud_database
DATABASE_USER=nextcloud
FULLTEXTSEARCH_INDEX=nextcloud-aio
FULLTEXTSEARCH_JAVA_OPTIONS="-Xms512M -Xmx512M"
# The account Nextcloud authenticates to Elasticsearch with. "elastic" is the
# image's built-in superuser, whose password is FULLTEXTSEARCH_PASSWORD above --
# leave it alone unless you provision a separate role in Elasticsearch first.
FULLTEXTSEARCH_USER=elastic
INSTALL_LATEST_MAJOR=no
# openjdk + ghostscript are required by the LibreSign app (occ libresign:install
# downloads Java-based signing binaries -- JSignPdf, pdftk -- that need a JVM and
# ghostscript to run). Confirmed working combo for Nextcloud AIO per community
# reports; see SETUP.md for the full LibreSign setup.
NEXTCLOUD_ADDITIONAL_APKS="imagemagick ghostscript openjdk17-jre-headless poppler-utils"
NEXTCLOUD_ADDITIONAL_PHP_EXTENSIONS=imagick
NEXTCLOUD_DATADIR=nextcloud_aio_nextcloud_data
NEXTCLOUD_MAX_TIME=3600
NEXTCLOUD_MEMORY_LIMIT=512M
# Applied automatically to new AND existing users by the nextcloud-aio-post-install
# one-shot service (see docker-compose.yml) once Nextcloud finishes installing --
# no manual occ command needed. Leave blank to skip setting a quota entirely.
DEFAULT_QUOTA=50 MB
# On macOS + Docker Desktop, this MUST be a path under a shared location (your
# home directory, /Volumes, /private, /tmp) -- /mnt (the upstream default) isn't
# shared by default and Nextcloud will fail to start with "mounts denied". Point
# this at an absolute path under your own checkout, e.g.
# /path/to/this/repo/host-mounts/mount (create the directory first).
NEXTCLOUD_MOUNT=/mnt/
# integration_google and integration_onedrive per Anirban's request -- both only
# install/enable automatically on a fresh install (this list runs once, on first
# startup). Each still needs its own OAuth app registered (Google Cloud Console /
# Azure AD) and configured in Nextcloud's admin settings before it actually works --
# installing the app doesn't configure the credentials.
# assistant and integration_openai are for the local Ollama AI assistant (see
# OLLAMA_MODEL above) -- assistant ships with Nextcloud but isn't enabled by
# default, integration_openai is what actually talks to Ollama's OpenAI-compatible
# API. Neither needs OAuth like the Google/OneDrive apps do, but integration_openai
# still needs its Service URL/model pointed at Ollama in admin settings -- see
# SETUP.md.
# libresign is for document signing -- installing it here doesn't finish setup by
# itself, still needs `occ libresign:install` to fetch its signing binaries and
# `occ libresign:configure:cfssl` to generate a root CA -- see SETUP.md.
# Apps that must be enabled, in Anirban's priority order (PR #1 review) -- the custom
# styling only applies to apps that are on. Also used as `defaultapp`, whose first
# ENABLED entry decides where users land after login.
#
# Enforced on every container start by nextcloud-exec-commands.sh. NEXTCLOUD_STARTUP_APPS
# below only runs on a FRESH install, so it is not enough on its own.
#
# mail and previewgenerator come from the app store, not the image. The hook will not
# fetch them; run `occ app:install mail previewgenerator` once per instance.
#
# NOTE: this does NOT control the order of icons in the top bar. That is a per-user
# setting (core/apporder) and Nextcloud has no admin-level default for it.
NEXTCLOUD_DEFAULT_APPS=dashboard,files,assistant,context_chat,richdocuments,mail,spreed,previewgenerator
NEXTCLOUD_STARTUP_APPS="deck twofactor_totp tasks calendar contacts notes integration_google integration_onedrive assistant integration_openai libresign mail previewgenerator"
# Same Docker Desktop file-sharing caveat as NEXTCLOUD_MOUNT above.
NEXTCLOUD_TRUSTED_CACERTS_DIR=/usr/local/share/ca-certificates/my-custom-ca
NEXTCLOUD_UPLOAD_LIMIT=16G
# Read by the Nextcloud AIO Tools custom app (nextcloud-custom-apps/nc_aio_tools)
# -- blocks creating any user past this many total accounts, via the web UI,
# `occ user:add`, and the provisioning API alike. Leave blank/unset to disable
# enforcement entirely. Requires a one-time `occ app:enable` -- see SETUP.md.
NC_USER_LIMIT=
# Must stay "no" for Context Chat to survive a restart. AIO's entrypoint.sh does:
#   if DOCKER_SOCKET_PROXY_ENABLED=yes or HARP_ENABLED=yes -> enable app_api
#   else if REMOVE_DISABLED_APPS=yes                       -> DISABLE app_api
# This stack deliberately has no docker socket anywhere, so with "yes" AIO disabled
# app_api on every single startup, silently killing Context Chat (its ExApp and daemon
# rows survive, so it looks registered but the backend reads as unreachable).
# Every OTHER use of this flag only removes an app when that app's own feature is off
# (richdocuments/collabora, spreed/talk, fulltextsearch) -- and this repo enables all
# of those profiles, so "no" changes nothing else in practice.
REMOVE_DISABLED_APPS=no
TALK_PORT=3478
UPDATE_NEXTCLOUD_APPS="no"

# --- Optional: S3 primary object storage (see SETUP.md) ---
# AIO's nextcloud image ships /var/www/html/config/s3.config.php, which builds the
# objectstore block from these and activates it ONLY when OBJECTSTORE_S3_BUCKET is
# non-empty. Leave the bucket blank to keep everything on local disk.
#
# This is an INSTALL-TIME choice. On a fresh install every file goes to the bucket;
# setting it on an instance that already holds files does NOT migrate them, it just
# stops Nextcloud finding the old ones.
OBJECTSTORE_S3_BUCKET=
OBJECTSTORE_S3_KEY=
OBJECTSTORE_S3_SECRET=
OBJECTSTORE_S3_REGION=
# Set HOST/PORT only for non-AWS endpoints (MinIO, Wasabi, Ceph). USEPATH_STYLE must
# be true for MinIO and most self-hosted gateways.
OBJECTSTORE_S3_HOST=
OBJECTSTORE_S3_PORT=
OBJECTSTORE_S3_SSL=true
OBJECTSTORE_S3_USEPATH_STYLE=false
OBJECTSTORE_S3_AUTOCREATE=true
