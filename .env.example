# Copy to .env and fill in real values. Never commit the real .env file.
# Based on https://github.com/nextcloud/all-in-one/blob/main/manual-install/sample.conf
# -- re-diff against that file before upgrading rather than hand-adding new vars here.

# --- Required secrets (must be unique, good passwords -- avoid '@' and ':') ---
DATABASE_PASSWORD=change-me
EUROOFFICE_SECRET=change-me
FULLTEXTSEARCH_PASSWORD=change-me
IMAGINARY_SECRET=change-me
NEXTCLOUD_PASSWORD=change-me
ONLYOFFICE_SECRET=change-me
RECORDING_SECRET=change-me
REDIS_PASSWORD=change-me
SIGNALING_SECRET=change-me
TALK_INTERNAL_SECRET=change-me
TURN_SECRET=change-me
WHITEBOARD_SECRET=change-me

# --- Domain / timezone ---
# Hostname you'll access Nextcloud through. Must match the nginx server_name in
# nginx-nextcloud.conf.sample. AIO hardcodes OVERWRITEPROTOCOL=https, so whatever
# fronts this on APACHE_PORT must actually terminate HTTPS (self-signed is fine
# for local dev) -- see SETUP.md.
NC_DOMAIN=nextcloud.local
TIMEZONE=UTC

# --- Optional features: all enabled per Anirban's request ---
# Setting these to "yes" (with quotes) enables the option inside Nextcloud
# automatically. The corresponding --profile flag also has to be passed on
# `docker compose up` for the container itself to be started -- see the profile
# list in the docker-compose.yml header comment.
CLAMAV_ENABLED="yes"
COLLABORA_ENABLED="yes"
EUROOFFICE_ENABLED="yes"
FULLTEXTSEARCH_ENABLED="yes"
IMAGINARY_ENABLED="yes"
ONLYOFFICE_ENABLED="yes"
TALK_ENABLED="yes"
TALK_RECORDING_ENABLED="yes"
WHITEBOARD_ENABLED="yes"

# --- Everything below: upstream defaults, unlikely to need changing for local dev ---
AIO_LOG_LEVEL=warn
APACHE_IP_BINDING=127.0.0.1
APACHE_MAX_SIZE=17179869184
APACHE_PORT=11000
ADDITIONAL_COLLABORA_OPTIONS=['--o:security.seccomp=true']
COLLABORA_DICTIONARIES="de_DE en_GB en_US es_ES fr_FR it nl pt_BR pt_PT ru"
FULLTEXTSEARCH_JAVA_OPTIONS="-Xms512M -Xmx512M"
INSTALL_LATEST_MAJOR=no
NEXTCLOUD_ADDITIONAL_APKS=imagemagick
NEXTCLOUD_ADDITIONAL_PHP_EXTENSIONS=imagick
NEXTCLOUD_DATADIR=nextcloud_aio_nextcloud_data
NEXTCLOUD_MAX_TIME=3600
NEXTCLOUD_MEMORY_LIMIT=512M
# On macOS + Docker Desktop, this MUST be a path under a shared location (your
# home directory, /Volumes, /private, /tmp) -- /mnt (the upstream default) isn't
# shared by default and Nextcloud will fail to start with "mounts denied". Point
# this at an absolute path under your own checkout, e.g.
# /path/to/this/repo/host-mounts/mount (create the directory first).
NEXTCLOUD_MOUNT=/mnt/
NEXTCLOUD_STARTUP_APPS="deck twofactor_totp tasks calendar contacts notes"
# Same Docker Desktop file-sharing caveat as NEXTCLOUD_MOUNT above.
NEXTCLOUD_TRUSTED_CACERTS_DIR=/usr/local/share/ca-certificates/my-custom-ca
NEXTCLOUD_UPLOAD_LIMIT=16G
REMOVE_DISABLED_APPS=yes
TALK_PORT=3478
UPDATE_NEXTCLOUD_APPS="no"
