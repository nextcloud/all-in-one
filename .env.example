# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=change-me

# --- Valkey (Redis-protocol-compatible cache) ---
VALKEY_PASSWORD=change-me

# --- Nextcloud admin (first-run bootstrap only) ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me
# Comma-separated list of hostnames Nextcloud will accept requests for.
# Include whatever local hostname/IP you're actually using.
NEXTCLOUD_TRUSTED_DOMAINS=nextcloud.local localhost

# --- Ceph demo (S3 provider for primary storage) ---
CEPH_DEMO_UID=nextcloud
CEPH_DEMO_ACCESS_KEY=change-me
CEPH_DEMO_SECRET_KEY=change-me
CEPH_DEMO_BUCKET=nextcloud-data
