# Rendered by the nginx:1.27-alpine image's own entrypoint
# (docker-entrypoint.d/20-envsubst-on-templates.sh) into /etc/nginx/conf.d/default.conf
# on every container start -- NOT hand-edited or reloaded manually. Mounted at
# /etc/nginx/templates/default.conf.template by nextcloud-aio-nginx in
# docker-compose.yml, which also declares NC_DOMAIN/NC_HTTPS_PORT/APACHE_PORT in that
# service's `environment` -- those are the only names substituted here (envsubst is
# restricted to variables actually present in the container's environment), so
# nginx's own $variables below (unset in this container's env) pass through untouched.
#
# See nginx-nextcloud.conf.sample for the reference version of this same config
# meant for a real, separately managed host/LB nginx instead of this container.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      keep-alive;
}

server {
    listen 80;
    server_name ${NC_DOMAIN};

    # Redirect everything to HTTPS -- Nextcloud AIO assumes HTTPS-only.
    return 301 https://$host:${NC_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${NC_DOMAIN};

    # Self-signed cert for local dev -- see SETUP.md for how these are generated.
    # Swap for a real cert (e.g. Let's Encrypt) outside local dev.
    ssl_certificate     /etc/nginx/certs/${NC_DOMAIN}.crt;
    ssl_certificate_key /etc/nginx/certs/${NC_DOMAIN}.key;

    location / {
        # nextcloud-aio-apache is not published to the host -- this reaches it over
        # the internal docker network by service name.
        proxy_pass http://nextcloud-aio-apache:${APACHE_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Nextcloud AIO expects this to say "https" even though the hop to
        # nextcloud-aio-apache above is plain HTTP -- the browser-facing connection
        # is what matters here.
        proxy_set_header X-Forwarded-Proto https;

        client_max_body_size 0;
        proxy_read_timeout 3600s;

        # Stream request bodies and upstream responses straight through instead of
        # spooling them to disk first, as AIO's reverse-proxy docs recommend. With
        # buffering on, a large PUT is written to disk in full before Nextcloud sees
        # a byte of it, so uploads stall.
        proxy_request_buffering off;
        proxy_buffering off;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        # Only forward an upgrade when the client actually asked for one -- see the
        # map{} above. A bare "Connection: upgrade" on every request stops normal
        # requests from being kept alive, so each one opens a fresh connection.
        proxy_set_header Connection $connection_upgrade;
    }
}
