# Sample vhost for the EXISTING host nginx (not part of the compose stack).
# Drop into your nginx sites config, adjust server_name and TLS to match
# whatever local hostname was decided, then reload nginx.

server {
    listen 80;
    server_name nextcloud.local;   # <-- replace with the chosen local hostname

    location / {
        proxy_pass http://127.0.0.1:11000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        client_max_body_size 0;
        proxy_read_timeout 3600s;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
